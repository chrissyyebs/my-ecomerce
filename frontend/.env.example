# ============================================================
# The Tote Life — FRONTEND Environment Variables (Public)
# Exposed to client bundle via Vite (must begin with VITE_)
# ============================================================

VITE_CLERK_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Backend API URL — use your backend Vercel deployment URL in production
# Local:      /api (proxied by Vite)
# Production: https://your-backend-project.vercel.app/api
VITE_API_BASE_URL=/api
