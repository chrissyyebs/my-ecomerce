# ============================================================
# The Tote Life — SERVER Environment Variables (Private Secrets)
# Never exposed to frontend bundle — server-side only
# ============================================================

# Supabase (Service Role Key for full DB access)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (Backend Secret & Webhook Secret)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=


# Telegram Bot (Secret Token & Admin Chat IDs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Nodemailer (SMTP Server Credentials)
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=587
NODEMAILER_USER=
NODEMAILER_PASS=
NODEMAILER_FROM="The Tote Life <noreply@thetotelife.com>"

# Cron Secret (Vercel Cron Authorization)
CRON_SECRET=super-secret-cron-key-change-me

# Environment
NODE_ENV=development
